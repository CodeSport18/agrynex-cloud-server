# Copy to .env for local development. On Render, set these in the dashboard.

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agrynex

# Shared secret the Raspberry Pi uses to connect. Put the same value in the Pi's .env.
DEVICE_TOKEN=

# Creates the first admin account when the database has no users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# S3 bucket for alert snapshots and clips
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Local development over plain http needs this set to false.
SESSION_COOKIE_SECURE=true
